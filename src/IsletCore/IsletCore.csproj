<Project Sdk="Microsoft.NET.Sdk">
  <!-- Pure, UI-free logic shared with the Mac app's IsletCore; runs and tests on any OS. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Islet.Core</RootNamespace>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="IsletCore.Tests" />
  </ItemGroup>
</Project>
